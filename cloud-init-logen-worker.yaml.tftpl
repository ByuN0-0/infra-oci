#cloud-config
write_files:
  - path: /usr/local/sbin/logen-worker-refresh-env
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      umask 077

      oci secrets secret-bundle get-secret-bundle-by-name \
        --auth instance_principal \
        --vault-id '${vault_id}' \
        --secret-name '${secret_name}' \
        --query 'data."secret-bundle-content".content' \
        --raw-output | base64 --decode >/run/logen-worker.env

      grep -q '^SUPABASE_URL=' /run/logen-worker.env
      grep -q '^SUPABASE_SERVICE_ROLE_KEY=' /run/logen-worker.env
      grep -q '^LOGEN_MODE=' /run/logen-worker.env
      install -m 0640 -o root -g logen-worker /run/logen-worker.env /etc/logen-worker/logen-worker.env
      rm -f /run/logen-worker.env

  - path: /usr/local/sbin/logen-worker-bootstrap
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      if ! swapon --show=NAME --noheadings | grep -qx '/swapfile'; then
        if [[ ! -f /swapfile ]]; then
          fallocate -l 1G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=1024
          chmod 0600 /swapfile
          mkswap /swapfile
        fi
        swapon /swapfile
      fi

      if ! grep -qE '^/swapfile[[:space:]]' /etc/fstab; then
        printf '/swapfile none swap sw 0 0\n' >>/etc/fstab
      fi

      if ! id logen-worker >/dev/null 2>&1; then
        useradd --system --home-dir /var/lib/logen-worker --create-home --shell /sbin/nologin logen-worker
      fi

      install -d -m 0755 -o root -g root /opt/logen-worker/bin /etc/logen-worker
      install -d -m 0750 -o logen-worker -g logen-worker /var/lib/logen-worker
      touch /etc/logen-worker/logen-worker.env
      chown root:logen-worker /etc/logen-worker/logen-worker.env
      chmod 0640 /etc/logen-worker/logen-worker.env

      dnf install -y ca-certificates curl jq
      dnf install -y python39-oci-cli || dnf install -y python3-oci-cli
      systemctl enable --now chronyd
      systemctl daemon-reload

  - path: /usr/local/sbin/logen-worker-run
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      while IFS= read -r line || [[ -n "$${line}" ]]; do
        [[ -z "$${line}" || "$${line}" == \#* ]] && continue
        key="$${line%%=*}"
        value="$${line#*=}"
        [[ "$${key}" =~ ^[A-Z][A-Z0-9_]*$ ]] || { printf 'Invalid environment key.\n' >&2; exit 1; }
        export "$${key}=$${value}"
      done </etc/logen-worker/logen-worker.env
      exec /opt/logen-worker/bin/logen-worker

  - path: /etc/systemd/system/logen-worker.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Logen Open API integration worker
      After=network-online.target
      Wants=network-online.target
      ConditionPathIsExecutable=/opt/logen-worker/bin/logen-worker

      [Service]
      Type=simple
      User=logen-worker
      Group=logen-worker
      Environment=GOMAXPROCS=1
      Environment=GOMEMLIMIT=384MiB
      ExecStartPre=+/usr/local/sbin/logen-worker-refresh-env
      ExecStart=/usr/local/sbin/logen-worker-run
      Restart=on-failure
      RestartSec=5s
      NoNewPrivileges=true
      PrivateTmp=true
      ProtectHome=true
      ProtectSystem=strict
      ReadWritePaths=/etc/logen-worker /var/lib/logen-worker

      [Install]
      WantedBy=multi-user.target

  - path: /opt/logen-worker/README.md
    owner: root:root
    permissions: "0644"
    content: |
      # Logen worker runtime

      The worker has no public IP. It pulls jobs from Supabase and calls Logen
      through the VCN NAT gateway. Runtime secrets are refreshed from the OCI
      Vault secret `${secret_name}` before every service start.

      Install the Linux amd64 binary at `/opt/logen-worker/bin/logen-worker`,
      then enable `logen-worker.service`.

runcmd:
  - /usr/local/sbin/logen-worker-bootstrap
